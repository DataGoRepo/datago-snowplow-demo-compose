<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/schemaListFragment">

    <fragment
        android:id="@+id/schemaListFragment"
        android:name="com.snowplowanalytics.snowplowdemokotlin.presentation.schemaListFragment.SchemaListFragment"
        android:label="fragment_schema_list"
        tools:layout="@layout/fragment_schema_list">
        <action
            android:id="@+id/action_to_schemaDetailFragment"
            app:destination="@id/schemaDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/schemaDetailFragment"
        android:name="com.snowplowanalytics.snowplowdemokotlin.presentation.schemaDetailFragment.SchemaDetailFragment"
        android:label="fragment_schema_detail"
        tools:layout="@layout/fragment_schema_detail">
        <action
            android:id="@+id/action_schemaDetailFragment_pop"
            app:popUpTo="@id/schemaListFragment" />
    </fragment>


</navigation>